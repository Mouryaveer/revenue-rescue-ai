# ============================================================
# RevenueRescue AI — Environment Variables
# Copy to .env and fill in values. Never commit .env to Git.
# Budget: ₹0 / month (Zero-Cost Free-Tier Cloud Deployment)
# ============================================================

# --- App & Execution Mode ---
APP_ENV=development  # development | demo | production
APP_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
PORT=8000

# --- Financial Safety Invariants ---
PAYMENT_MODE=simulation          # simulation | test | live (live is strictly blocked by default)
ALLOW_REAL_PAYMENTS=false        # NON-NEGOTIABLE: must remain false for ₹0 budget safety
PAYMENT_PROVIDER=simulator       # "simulator" (default, ₹0) or "razorpay_test" (test mode only)

# --- Quantitative Machine Learning (LightGBM) ---
# Path to trained LightGBM model artifact bundle.
# If missing, system falls back safely to deterministic heuristic scoring.
LIGHTGBM_MODEL_PATH=models/artifacts/lightgbm_recovery_model.joblib

# --- Reasoning Provider (Serverless Inference) ---
# Options:
#   "deterministic" (default, ₹0, no API key needed, rule + ML grounded)
#   "cloudflare"    (Cloudflare Workers AI free tier: 10,000 neurons/day)
#   "openai"        (Paid / trial OpenAI-compatible API)
LLM_PROVIDER=deterministic
REASONING_PROVIDER=deterministic
REASONING_MODEL=@cf/deepseek-ai/deepseek-r1-distill-qwen-32b

# Cloudflare Workers AI credentials (required only when LLM_PROVIDER=cloudflare)
# Obtain from Cloudflare Dashboard -> Workers & Pages -> Overview -> Account ID & API Tokens
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
LLM_TIMEOUT_SECONDS=30
MAX_LLM_OUTPUT_TOKENS=512

# OpenAI (required only when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Database ---
# Local Docker Postgres: postgresql+asyncpg://revenuerescue:revenuerescue@localhost:5432/revenuerescue
# Supabase Free Postgres: postgresql+asyncpg://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?ssl=require
# Render Free / Neon Free: postgresql+asyncpg://[USER]:[PASSWORD]@[HOST]/[DB]?ssl=require
DATABASE_URL=postgresql+asyncpg://revenuerescue:revenuerescue@localhost:5432/revenuerescue

# --- Redis (Optional for MVP; background jobs default to in-process FastAPI BackgroundTasks) ---
REDIS_URL=redis://localhost:6379/0

# --- Razorpay Test Mode (Test Keys ONLY — Provider will reject live keys) ---
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# --- LangSmith (Optional observability) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=revenuerescue-ai

# --- Simulation Defaults ---
SIMULATION_MODE=true
SIMULATION_SEED=42
DEMO_MODE=false
AI_MODE=false
BASELINE_MODE=false

# --- Auth & Security ---
JWT_SECRET=change-me-to-another-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:5173"]

# --- Frontend (Vite / Static Hosting) ---
VITE_API_URL=http://localhost:8000
VITE_APP_MODE=simulation
