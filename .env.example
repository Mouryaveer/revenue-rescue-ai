# ============================================================
# RevenueRescue AI — Environment Variables
# Copy to .env and fill in values. Never commit .env to Git.
# ============================================================

# --- App ---
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true

# --- Database ---
DATABASE_URL=postgresql+asyncpg://revenuerescue:revenuerescue@postgres:5432/revenuerescue
POSTGRES_USER=revenuerescue
POSTGRES_PASSWORD=revenuerescue
POSTGRES_DB=revenuerescue

# --- Redis (optional for MVP — stub if not available) ---
REDIS_URL=redis://redis:6379/0

# --- Payment Provider ---
# "simulator" (default, no credentials) or "razorpay_test" (test-mode only)
PAYMENT_PROVIDER=simulator

# --- Razorpay Test Mode (ONLY test keys — never production) ---
# Keys must start with "rzp_test_" — provider will refuse production keys
RAZORPAY_KEY_ID=rzp_test_...your_test_key_id...
RAZORPAY_KEY_SECRET=...your_test_key_secret...

# --- LLM Provider ---
# Set to "openai" to use real LLM, "mock" for deterministic fallback (no API key needed)
LLM_PROVIDER=mock
OPENAI_API_KEY=sk-...your-key-here...
OPENAI_MODEL=gpt-4o

# --- LangSmith (optional observability) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=revenuerescue-ai

# --- Simulation ---
SIMULATION_MODE=true
SIMULATION_SEED=42

# --- Demo Mode ---
DEMO_MODE=false

# --- Feature Flags ---
AI_MODE=false
BASELINE_MODE=false

# --- Auth ---
JWT_SECRET=change-me-to-another-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_MODE=simulation
